graph TB
    %% Main Request Flow
    Client[Client Request] --> Router[Main Router]
    
    %% Authentication Layer
    Router --> AuthMiddleware{Auth Middleware}
    AuthMiddleware -->|Unauthorized| ErrorResponse[Error Response]
    AuthMiddleware -->|Authorized| OrgContext[Organization Context]
    
    %% Organization Context
    OrgContext --> ModuleCheck{Module Access Check}
    ModuleCheck -->|Module Not Enabled| ModuleError[Module Not Available]
    ModuleCheck -->|Module Enabled| ModuleRouter[Module Router]
    
    %% Module Registry System
    subgraph "Module Registry System"
        Registry[Module Registry]
        Registry --> SalonModule[Salon Module]
        Registry --> RestaurantModule[Restaurant Module]
        Registry --> ClubModule[Club Module]
        Registry --> FutureModule[Future Modules...]
        
        Registry --> ModuleStore[(Module Store DB)]
    end
    
    %% Core System
    subgraph "Core System (Shared)"
        CoreInterfaces[Core Interfaces]
        CoreModels[Core Models]
        CoreServices[Core Services]
        
        CoreInterfaces --> IOrganization[IOrganization]
        CoreInterfaces --> IEmployee[IEmployee]
        CoreInterfaces --> IAuth[IAuth]
        CoreInterfaces --> IPayment[IPayment]
        
        CoreServices --> AuthService[Auth Service]
        CoreServices --> OrgService[Organization Service]
        CoreServices --> EmployeeService[Employee Service]
        CoreServices --> PaymentService[Payment Service]
    end
    
    %% Module Structure Example - Salon
    subgraph "Salon Module"
        SalonInterface[Salon Module Interface]
        
        subgraph "Salon Components"
            SalonModels[Salon Models]
            SalonDTOs[Salon DTOs]
            SalonControllers[Salon Controllers]
            SalonServices[Salon Services]
            SalonRepos[Salon Repositories]
            
            SalonModels --> Appointment[Appointment Model]
            SalonModels --> Treatment[Treatment Model]
            SalonModels --> Staff[Staff Model]
            
            SalonServices --> AppointmentSvc[Appointment Service]
            SalonServices --> TreatmentSvc[Treatment Service]
            SalonServices --> StaffSvc[Staff Service]
        end
        
        SalonInterface --> SalonComponents
    end
    
    %% Database Layer
    subgraph "Database Layer"
        MainDB[(Main Database)]
        
        subgraph "Core Tables"
            OrgTable[organizations]
            EmpTable[employees]
            UserTable[users]
            ModuleConfigTable[organization_modules]
        end
        
        subgraph "Module Tables"
            SalonTables[Salon Tables]
            RestaurantTables[Restaurant Tables]
            ClubTables[Club Tables]
            
            SalonTables --> ApptTable[appointments]
            SalonTables --> TreatTable[treatments]
            SalonTables --> StaffSchedTable[staff_schedules]
        end
        
        MainDB --> CoreTables
        MainDB --> ModuleTables
    end
    
    %% Request Processing Flow
    ModuleRouter --> ModuleController[Module Controller]
    ModuleController --> ModuleService[Module Service]
    ModuleService --> CoreServices
    ModuleService --> ModuleRepo[Module Repository]
    ModuleRepo --> MainDB
    
    %% Response Flow
    ModuleService --> ResponseDTO[Response DTO]
    ResponseDTO --> JSONResponse[JSON Response]
    JSONResponse --> Client
    
    %% Module Lifecycle
    subgraph "Module Lifecycle"
        Register[Register Module]
        Initialize[Initialize Module]
        Migrate[Run Migrations]
        Enable[Enable for Org]
        Validate[Validate Access]
        
        Register --> Initialize
        Initialize --> Migrate
        Migrate --> Enable
        Enable --> Validate
    end
    
    %% Organization Flow
    subgraph "Organization Setup Flow"
        CreateOrg[Create Organization]
        SelectType[Select Org Type]
        AvailableModules[Get Available Modules]
        EnableModules[Enable Modules]
        ConfigureModules[Configure Modules]
        
        CreateOrg --> SelectType
        SelectType --> AvailableModules
        AvailableModules --> EnableModules
        EnableModules --> ConfigureModules
    end

%% Styling
classDef core fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
classDef module fill:#50C878,stroke:#3A9B5C,stroke-width:2px,color:#fff
classDef database fill:#FFB84D,stroke:#CC8E3D,stroke-width:2px,color:#fff
classDef interface fill:#9B59B6,stroke:#7D3C98,stroke-width:2px,color:#fff
classDef middleware fill:#E74C3C,stroke:#C0392B,stroke-width:2px,color:#fff

class CoreInterfaces,CoreModels,CoreServices core
class SalonModule,RestaurantModule,ClubModule module
class MainDB,ModuleStore database
class SalonInterface,IOrganization,IEmployee interface
class AuthMiddleware,ModuleCheck middleware