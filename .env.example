# Template for .env.development / .env.production / .env.docker.
# Copy to the file matching your APP_ENV and fill in real values.
# The real .env.* files are gitignored — never commit secrets here.

# --------------------
# App
# --------------------
APP_ENV=development          # development | production | docker
PORT=8080

# --------------------
# Database (Postgres)
# --------------------
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sharpnrdb
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable           # disable | require | verify-full — used by both the pool and the migrator

# --------------------
# Redis
# --------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s        # also bounds the startup PING
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# --------------------
# JWT
# --------------------
# Required, no defaults. Minimum 32 bytes for JWT_SECRET.
# Issuer and audience are verified on every parse — changing either
# invalidates every token already in circulation.
JWT_SECRET=
JWT_ISSUER=sharpnr-engine
JWT_AUDIENCE=sharpnr-client
JWT_ACCESS_TTL=15m           # must be shorter than JWT_REFRESH_TTL
JWT_REFRESH_TTL=168h
JWT_SIGNUP_TTL=24h           # also the Max-Age of the signup cookie
JWT_AUTH_WEB_COOKIE_TTL=10h  # also the Max-Age of the web auth cookie
JWT_EMPLOYEE_PROVISIONING_TOKEN_TTL=168 # 7days can be changed later

# --------------------
# TTLs (Business)
# --------------------
# Lifetime of the org signup staging record in Redis. The record carries the
# signup OTP and nothing else enforces OTP expiry, so this is the OTP window.
SIGNUP_STAGING_TTL=40m

# --------------------
# Mailer
# --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=10s

# mailer aliases
EMAIL_FROM_OTP=verifications@sharpnr.com
EMAIL_FROM_BILLING=receipts@sharpnr.com
EMAIL_FROM_NOTIFICATION=notifications@sharpnr.com
EMAIL_FROM_VERIFICATION=verifications@sharpnr.com
EMAIL_FROM_SUPPORT=notifications@sharpnr.com
